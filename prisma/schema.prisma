generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  TENANT
}

model Profile {
  id           String      @id // Maps 1:1 with Supabase auth.users.id
  email        String      @unique
  fullName     String
  phone        String?
  role         Role        @default(OWNER)
  avatarUrl    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  
  workspaces   Workspace[] @relation("WorkspaceOwner")
  tenancies    Tenant[]
  documents    TenantDocument[]
  wishlistItems WishlistItem[]
}

model Workspace {
  wid            Int        @id @default(autoincrement()) // Auto-incrementing integer workspace ID (1, 2, 3...)
  name           String     // Workspace / Company Name
  currency       String     @default("USD ($)")
  portfolioScale String?
  businessType   String?
  operatingCity  String?
  portfolioFocus String?
  dueDay         Int?       @default(1)
  isOnboarded    Boolean    @default(false)
  plan           String     @default("trial") // "trial" | "free" | "starter" | "pro" | "pro_plus"
  trialStartedAt DateTime   @default(now()) // 14-day free trial starts at account/workspace creation; then Free plan
  aiCreditsUsed  Int        @default(0)     // AI credits consumed; limit depends on plan (free=20, starter=50, pro=200, pro_plus=500)

  // General Organization & Compliance Settings — no seed defaults; stay empty until user fills them
  companyType       String?
  taxId             String?
  registeredAddress String?
  landlordName      String?
  landlordRole      String?
  companyEmail      String?
  companyPhone      String?
  jurisdiction      String?
  pincode           String?
  timezone          String?
  fiscalYearStart   String?
  customSubdomain   String?
  tagline           String?
  
  ownerId        String
  owner          Profile    @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  
  properties     Property[]
  units          Unit[]
  tenants        Tenant[]
  bills          Bill[]
  maintenances   Maintenance[]
  roomHistories  RoomHistory[]
  documents      TenantDocument[]
  expenses       PropertyExpense[]
  teamMembers    TeamMember[]
  subscriptions  Subscription[]
  transactions   Transaction[]
  supportTickets SupportTicket[]
  announcements  Announcement[]
  propertyListings PropertyListing[]
  tenantInquiries  TenantInquiry[]
  chatRooms        ChatRoom[]
  aiBills          AiBill[]
  aiUsageLogs      AiUsageLog[]
  
  // Razorpay Payment Gateway Config
  razorpayKeyId         String?
  razorpayKeySecret     String?
  razorpayMerchantVpa   String?
  razorpayWebhookSecret String?
  razorpayEnvMode       String?   @default("test")
  razorpayConnected     Boolean   @default(false)

  // Stripe Payment Gateway Config
  stripePublishableKey  String?
  stripeSecretKey       String?
  stripeWebhookSecret   String?
  stripeConnectAccountId String?
  stripeEnvMode         String?   @default("test")
  stripeConnected       Boolean   @default(false)

  // PayPal Payment Gateway Config
  paypalClientId        String?
  paypalClientSecret    String?
  paypalMerchantEmail   String?
  paypalWebhookId       String?
  paypalEnvMode         String?   @default("test")
  paypalConnected       Boolean   @default(false)

  // Direct UPI & QR Code Config (Generic Fallback)
  upiId                 String?
  upiPhoneNumber        String?
  upiQrCodeUrl          String?
  upiAccountName        String?
  upiAppsSupported      String?
  upiConnected          Boolean   @default(false)

  // Google Pay (GPay) Direct Config
  gpayUpiId             String?
  gpayPhoneNumber       String?
  gpayQrCodeUrl         String?
  gpayConnected         Boolean   @default(false)

  // PhonePe Direct Config
  phonepeUpiId          String?
  phonepePhoneNumber    String?
  phonepeQrCodeUrl      String?
  phonepeConnected      Boolean   @default(false)

  // Paytm Direct Config
  paytmUpiId            String?
  paytmPhoneNumber      String?
  paytmQrCodeUrl        String?
  paytmConnected        Boolean   @default(false)

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([ownerId])
}

model Property {
  id            String    @id @default(cuid())
  name          String
  category      String
  pincode       String?
  address       String
  floors        Int       @default(1)
  unitsPerFloor Int       @default(4)
  totalUnits    Int       @default(4)
  avgRent       Float     @default(0)
  sqft          Float?

  // AI Summary Cache — stores the most recent AI-generated property summary
  aiSummary            String?   // The last generated AI summary text
  aiSummaryGeneratedAt DateTime? // When the summary was last generated
  
  workspaceId   Int
  workspace     Workspace @relation(fields: [workspaceId], references: [wid], onDelete: Cascade)
  
  units         Unit[]
  tenants       Tenant[]
  bills         Bill[]
  maintenances  Maintenance[]
  roomHistories RoomHistory[]
  documents     TenantDocument[]
  expenses      PropertyExpense[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId])
}

model Unit {
  id          String   @id @default(cuid())
  unitNumber  String   // e.g. "Unit 101"
  floorNumber Int      @default(1)
  rent        Float    @default(0)
  sqft        Float?
  isOccupied  Boolean  @default(false)
  
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  workspaceId Int?
  workspace   Workspace? @relation(fields: [workspaceId], references: [wid], onDelete: SetNull)

  tenants     Tenant[]
  bills       Bill[]
  maintenances Maintenance[]
  roomHistories RoomHistory[]
  documents   TenantDocument[]
  expenses    PropertyExpense[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([propertyId])
  @@index([workspaceId])
}

model Tenant {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String
  leaseStart    DateTime
  leaseEnd      DateTime?
  healthScore     Int      @default(75)
  monthlyRent     Float    @default(0)
  securityDeposit Float?   @default(0)
  rentBillingType String   @default("monthly") // kept for DB compat; app uses monthly rent only
  rentDueDay      Int?     @default(1) // Day of month (1–28) when recurring rent invoices generate
  currentStatus   String   @default("Current") // "Current" | "Past" | "Exited" | "Evicted"
  bedSlot       String?
  govIdType     String?
  govIdNumber   String?
  govIdUrl      String?
  leaseDocUrl   String?
  floorNumber   Int?
  
  profileId     String?
  profile       Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  
  unitId        String?
  unit          Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)

  propertyId    String?
  property      Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  workspaceId   Int?
  workspace     Workspace? @relation(fields: [workspaceId], references: [wid], onDelete: SetNull)

  bills         Bill[]
  maintenances  Maintenance[]
  roomHistories RoomHistory[]
  documents     TenantDocument[]
  chatRooms     ChatRoom[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([profileId])
  @@index([unitId])
  @@index([propertyId])
  @@index([workspaceId])
}

model Feedback {
  id          String   @id @default(cuid())
  category    String   @default("General Feedback")
  rating      Int      @default(5)
  isAnonymous Boolean  @default(false)
  name        String?
  email       String?
  subject     String?
  message     String
  createdAt   DateTime @default(now())
}

model Bill {
  id            String    @id @default(cuid())
  invoiceNumber String    // e.g. "INV-2026-07-COMB", "UTIL-2026-07"
  title         String    // e.g. "July Combined Room Rent Invoice"
  amount        Float     @default(0)
  status        String    @default("Paid") // "Paid", "Pending", "Overdue", "Cancelled"
  category      String    @default("Rent") // "Rent", "Utility", "Maintenance", "Deposit"
  paymentMethod String?   @default("Autopilot Consolidated")
  dueDate       DateTime  @default(now())
  paidDate      DateTime?
  notes         String?
  floorNumber   Int?

  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  unitId        String?
  unit          Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)

  propertyId    String?
  property      Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  workspaceId   Int?
  workspace     Workspace? @relation(fields: [workspaceId], references: [wid], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([unitId])
  @@index([propertyId])
  @@index([workspaceId])
}

model Maintenance {
  id            String    @id @default(cuid())
  ticketNumber  String    // e.g. "TKT-1001"
  issue         String    // Maintenance issue description
  category      String    @default("General Repair")
  priority      String    @default("Normal")
  status        String    @default("Open") // "Open", "In Progress", "Resolved", "Cancelled"
  cost          Float     @default(0)
  notes         String?
  floorNumber   Int?
  loggedBy      String?   // e.g. "John Doe (Tenant)", "Admin"

  tenantId      String?   // Column for tenant ID who logged the ticket
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  unitId        String?   // Unit ID
  unit          Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)

  propertyId    String?   // Property ID
  property      Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  workspaceId   Int?      // Workspace ID
  workspace     Workspace? @relation(fields: [workspaceId], references: [wid], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([unitId])
  @@index([propertyId])
  @@index([workspaceId])
}

model RoomHistory {
  id                String    @id @default(cuid())
  name              String    // Past Resident / Occupant Name
  period            String    // e.g. "Jan 2025 - Dec 2025"
  rent              String    // e.g. "$1,200/mo"
  status            String    @default("Lease Completed") // "Lease Completed", "Removed / Evicted", "Active Occupant"
  review            String?   // Landlord rating review / notes
  rating            Int?      @default(5) // 1-5 star rating
  healthScore       Int?      @default(85) // 85 / 100 assigned upon offboarding/leaving
  removalReason     String?   // Breach reason if evicted
  depositSettlement String?   // e.g. "Full Deposit Refunded"
  keysReturned      Boolean   @default(true)
  moveIn            DateTime?
  moveOut           DateTime?
  floorNumber       Int?

  tenantId          String?
  tenant            Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  unitId            String?
  unit              Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)

  propertyId        String?
  property          Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  workspaceId       Int?
  workspace         Workspace? @relation(fields: [workspaceId], references: [wid], onDelete: SetNull)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tenantId])
  @@index([unitId])
  @@index([propertyId])
  @@index([workspaceId])
}

model TenantDocument {
  id            String    @id @default(cuid())
  title         String    // Document title e.g. "Govt ID (Passport)", "Signed Lease Agreement"
  docType       String    @default("Lease Agreement") // "Govt ID", "Lease Agreement", "Proof of Income", etc.
  fileUrl       String    // Cloudflare R2 public URL
  fileName      String    // e.g. "passport_john.pdf"
  fileSize      String?   // e.g. "1.2 MB"
  mimeType      String?   // e.g. "application/pdf"
  floorNumber   Int?
  isDocs        Boolean   @default(false) // true if created/uploaded from Landlord Documents for sending to tenants

  profileId     String?
  profile       Profile?  @relation(fields: [profileId], references: [id], onDelete: SetNull)

  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  unitId        String?
  unit          Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)

  propertyId    String?
  property      Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  workspaceId   Int?
  workspace     Workspace? @relation(fields: [workspaceId], references: [wid], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([profileId])
  @@index([tenantId])
  @@index([unitId])
  @@index([propertyId])
  @@index([workspaceId])
}

model PropertyExpense {
  id            String    @id @default(cuid())
  expenseNumber String?   // e.g. "EXP-901"
  title         String
  category      String    @default("Maintenance & Repairs")
  amount        Float     @default(0)
  date          DateTime  @default(now())
  vendor        String?
  paymentMethod String?   @default("Bank Wire / ACH Transfer")
  receiptName   String?
  receiptUrl    String?
  status        String    @default("Verified & Paid")

  unitId        String?
  unit          Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)

  propertyId    String?
  property      Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  workspaceId   Int?
  workspace     Workspace? @relation(fields: [workspaceId], references: [wid], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([unitId])
  @@index([propertyId])
  @@index([workspaceId])
}

model TeamMember {
  id          String    @id @default(cuid())
  name        String
  email       String
  countryCode String?   @default("+1")
  phone       String?
  role        String    @default("Manager") // "Owner", "Admin", "Manager", "Employee"
  status      String    @default("Active")
  password    String?

  workspaceId Int?
  workspace   Workspace? @relation(fields: [workspaceId], references: [wid], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
}

model Transaction {
  id                String    @id @default(cuid())
  transactionNumber String    // e.g. "TXN-2026-901"
  paymentId         String?   // e.g. "pay_P9283401"
  orderId           String?   // e.g. "sub_abc123" or "order_xyz"
  type              String    @default("Subscription Payment") // "Subscription Payment", "Rent Collection", "Expense Payout"
  amount            String    // e.g. "$15.00 USD" or "₹1,474"
  status            String    @default("Success")
  paymentMethod     String?   @default("Razorpay Auto-Debit")
  description       String?

  workspaceId       Int?
  workspace         Workspace? @relation(fields: [workspaceId], references: [wid], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([workspaceId])
}

model Subscription {
  id            String    @id @default(cuid())
  invoiceNumber String    // e.g. "INV-2026-008"
  receiptNumber String    // e.g. "RCPT-2026-008"
  planName      String    // e.g. "Pro Portfolio Plan"
  amount        String    // e.g. "$15.00 USD" or "₹1,474"
  billingTerm   String    @default("Monthly") // "Monthly" or "Annual"
  paymentType   String    @default("Recurring Subscription") // "Recurring Subscription" or "One-Time Payment"
  paymentMethod String    @default("Razorpay (Visa •••• 4242)")
  paymentId     String?   // Razorpay Payment ID e.g. "pay_P192834"
  status        String    @default("Paid")

  workspaceId   Int?
  workspace     Workspace? @relation(fields: [workspaceId], references: [wid], onDelete: Cascade)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId])
}

model SupportTicket {
  id            String    @id @default(cuid())
  ticketNumber  String    // e.g. "TKT-2026-001"
  subject       String
  category      String    @default("General Inquiry") // "Billing & Invoices", "Tenant Portal", "AI Documents", "Technical Issue"
  priority      String    @default("Medium") // "Low", "Medium", "High", "Urgent"
  status        String    @default("Open") // "Open", "In Progress", "Resolved", "Closed"
  message       String
  contactEmail  String?
  contactPhone  String?
  adminReply    String?
  adminRepliedAt DateTime?
  attachments   String[]  @default([])
  isTenant      Boolean   @default(false) // true = created by tenant portal; false = landlord dashboard

  workspaceId   Int?
  workspace     Workspace? @relation(fields: [workspaceId], references: [wid], onDelete: Cascade)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId])
  @@index([isTenant])
}

model EarlyAccessLead {
  id            String   @id @default(cuid())
  fullName      String
  email         String
  phone         String?
  portfolioType String?  // "Landlord (1-5 Units)", "Portfolio Owner (50+ Units)", etc.
  notes         String?
  createdAt     DateTime @default(now())
}

model Announcement {
  id               String     @id @default(cuid())
  title            String
  content          String
  category         String     @default("General Notice") // "General Notice", "Maintenance Alert", "Policy Update", "Community Event", "Emergency Alert"
  priority         String     @default("Normal") // "Normal", "Important", "Urgent"
  targetScope      String     @default("ALL_PROPERTIES") // "ALL_PROPERTIES", "SPECIFIC_PROPERTIES", "SPECIFIC_TENANTS"
  targetProperties String[]   // Property IDs or names
  targetTenants    String[]   // Tenant IDs or emails
  isPinned         Boolean    @default(false)
  creatorName      String?    @default("Landlord / Management")

  workspaceId      Int?
  workspace        Workspace? @relation(fields: [workspaceId], references: [wid], onDelete: Cascade)

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([workspaceId])
}

model PropertyListing {
  id                 String   @id @default(cuid())
  title              String
  description        String?
  propertyType       String
  sqft               Float?
  rent               Float
  deposit            Float?
  tenantTypes        String[]
  availableFrom      String?
  maintenance        String?
  customMaintenance  String?
  pincode            String?
  stateName          String?
  city               String?
  locality           String?
  fullAddress        String?
  pinnedLat          Float?
  pinnedLng          Float?
  amenities          String[]
  mainImage          String?
  coverImage         String?
  galleryImages      String[]
  contactPersonName  String?
  contactNumber      String?
  countryDialCode    String?  @default("+91")
  countryCode        String?  @default("IN")
  whatsappEnabled    Boolean  @default(true)
  isLive             Boolean  @default(true)
  status             String   @default("Active") // "Active", "Draft", "Rented"
  inquiriesCount     Int      @default(0)
  viewsCount         Int      @default(0)
  avgRating          Float    @default(4.8)
  reviewCount        Int      @default(0)

  inquiries          TenantInquiry[]
  reviews            PropertyReview[]
  wishlistItems      WishlistItem[]

  workspaceId        Int?
  workspace          Workspace? @relation(fields: [workspaceId], references: [wid], onDelete: Cascade)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([workspaceId])
  @@index([city])
  @@index([status])
}

model PropertyReview {
  id              String           @id @default(cuid())
  userName        String           @default("Verified Resident")
  userRole        String           @default("Current Resident")
  overallRating   Float            @default(5.0)
  qualityRating   Float?           @default(5.0)
  localityRating  Float?           @default(5.0)
  landlordRating  Float?           @default(5.0)
  headline        String?
  comment         String

  listingId       String
  listing         PropertyListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([listingId])
}


model TenantInquiry {
  id              String           @id @default(cuid())
  tenantName      String
  phone           String
  email           String?
  moveInDate      String?
  status          String           @default("Inquiry Pending") // "Inquiry Pending", "Visit Scheduled", "Tenant Chosen", "Contacted"
  notes           String?
  
  listingId       String?
  listing         PropertyListing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  
  workspaceId     Int?
  workspace       Workspace?       @relation(fields: [workspaceId], references: [wid], onDelete: Cascade)
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([workspaceId])
  @@index([listingId])
  @@index([status])
}

model WishlistItem {
  id        String          @id @default(cuid())
  profileId String
  profile   Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  listingId String
  listing   PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([profileId, listingId])
  @@index([profileId])
  @@index([listingId])
}

model ChatRoom {
  id           String        @id @default(cuid())
  type         String        @default("dm") // "group" | "dm"
  name         String
  initials     String?
  color        String?       @default("bg-purple-500")
  property     String?
  description  String?
  lastMessage  String?
  lastTime     String?
  unreadCount  Int           @default(0)
  membersJson  String?       // JSON string of member objects
  
  tenantId     String?       // Associated tenant ID if DM
  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  workspaceId  Int?
  workspace    Workspace?    @relation(fields: [workspaceId], references: [wid], onDelete: Cascade)

  messages     ChatMessage[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([workspaceId])
  @@index([tenantId])
}

model ChatMessage {
  id            String   @id @default(cuid())
  senderId      String
  senderName    String
  senderInitials String
  text          String
  isMe          Boolean  @default(false)

  roomId        String
  room          ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())

  @@index([roomId])
}

model AiBill {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique
  amount        Float
  credits       Int
  packName      String
  paymentId     String?
  paymentMethod String    @default("Razorpay Live Gateway")
  status        String    @default("SUCCESS")

  workspaceId   Int
  workspace     Workspace @relation(fields: [workspaceId], references: [wid], onDelete: Cascade)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId])
  @@index([status])
}

model AiUsageLog {
  id          String    @id @default(cuid())
  feature     String
  targetItem  String
  question    String
  creditsCost Int       @default(2)
  status      String    @default("Completed")

  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [wid], onDelete: Cascade)

  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

model ContactInquiry {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  phone     String?
  category  String   @default("General Inquiry")
  subject   String?
  message   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
}
