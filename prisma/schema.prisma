generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  TENANT
}

model Profile {
  id           String      @id // Maps 1:1 with Supabase auth.users.id
  email        String      @unique
  fullName     String
  phone        String?
  role         Role        @default(OWNER)
  avatarUrl    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  
  workspaces   Workspace[] @relation("WorkspaceOwner")
  tenancies    Tenant[]
  documents    TenantDocument[]
}

model Workspace {
  wid            Int        @id @default(autoincrement()) // Auto-incrementing integer workspace ID (1, 2, 3...)
  name           String     // Workspace / Company Name
  currency       String     @default("USD ($)")
  portfolioScale String?
  plan           String     @default("starter") // "starter", "pro", "enterprise"
  
  ownerId        String
  owner          Profile    @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  
  properties     Property[]
  units          Unit[]
  tenants        Tenant[]
  bills          Bill[]
  maintenances   Maintenance[]
  roomHistories  RoomHistory[]
  documents      TenantDocument[]
  expenses       PropertyExpense[]
  teamMembers    TeamMember[]
  subscriptions  Subscription[]
  transactions   Transaction[]
  supportTickets SupportTicket[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([ownerId])
}

model Property {
  id            String    @id @default(cuid())
  name          String
  category      String
  pincode       String?
  address       String
  floors        Int       @default(1)
  unitsPerFloor Int       @default(4)
  totalUnits    Int       @default(4)
  avgRent       Float     @default(0)
  
  workspaceId   Int
  workspace     Workspace @relation(fields: [workspaceId], references: [wid], onDelete: Cascade)
  
  units         Unit[]
  tenants       Tenant[]
  bills         Bill[]
  maintenances  Maintenance[]
  roomHistories RoomHistory[]
  documents     TenantDocument[]
  expenses      PropertyExpense[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId])
}

model Unit {
  id          String   @id @default(cuid())
  unitNumber  String   // e.g. "Unit 101"
  floorNumber Int      @default(1)
  rent        Float    @default(0)
  isOccupied  Boolean  @default(false)
  
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  workspaceId Int?
  workspace   Workspace? @relation(fields: [workspaceId], references: [wid], onDelete: SetNull)

  tenants     Tenant[]
  bills       Bill[]
  maintenances Maintenance[]
  roomHistories RoomHistory[]
  documents   TenantDocument[]
  expenses    PropertyExpense[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([propertyId])
  @@index([workspaceId])
}

model Tenant {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String
  leaseStart    DateTime
  leaseEnd      DateTime?
  healthScore     Int      @default(75)
  monthlyRent     Float    @default(0)
  securityDeposit Float?   @default(0)
  currentStatus   String   @default("Current") // "Current" | "Past" | "Exited" | "Evicted"
  bedSlot       String?
  govIdType     String?
  govIdNumber   String?
  govIdUrl      String?
  leaseDocUrl   String?
  floorNumber   Int?
  
  profileId     String?
  profile       Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  
  unitId        String?
  unit          Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)

  propertyId    String?
  property      Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  workspaceId   Int?
  workspace     Workspace? @relation(fields: [workspaceId], references: [wid], onDelete: SetNull)

  bills         Bill[]
  maintenances  Maintenance[]
  roomHistories RoomHistory[]
  documents     TenantDocument[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([profileId])
  @@index([unitId])
  @@index([propertyId])
  @@index([workspaceId])
}

model Feedback {
  id          String   @id @default(cuid())
  category    String   @default("General Feedback")
  rating      Int      @default(5)
  isAnonymous Boolean  @default(false)
  name        String?
  email       String?
  subject     String?
  message     String
  createdAt   DateTime @default(now())
}

model Bill {
  id            String    @id @default(cuid())
  invoiceNumber String    // e.g. "INV-2026-07-COMB", "UTIL-2026-07"
  title         String    // e.g. "July Combined Room Rent Invoice"
  amount        Float     @default(0)
  status        String    @default("Paid") // "Paid", "Pending", "Overdue", "Cancelled"
  category      String    @default("Rent") // "Rent", "Utility", "Maintenance", "Deposit"
  paymentMethod String?   @default("Autopilot Consolidated")
  dueDate       DateTime  @default(now())
  paidDate      DateTime?
  notes         String?
  floorNumber   Int?

  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  unitId        String?
  unit          Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)

  propertyId    String?
  property      Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  workspaceId   Int?
  workspace     Workspace? @relation(fields: [workspaceId], references: [wid], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([unitId])
  @@index([propertyId])
  @@index([workspaceId])
}

model Maintenance {
  id            String    @id @default(cuid())
  ticketNumber  String    // e.g. "TKT-1001"
  issue         String    // Maintenance issue description
  category      String    @default("General Repair")
  priority      String    @default("Normal")
  status        String    @default("Open") // "Open", "In Progress", "Resolved", "Cancelled"
  cost          Float     @default(0)
  notes         String?
  floorNumber   Int?
  loggedBy      String?   // e.g. "John Doe (Tenant)", "Admin"

  tenantId      String?   // Column for tenant ID who logged the ticket
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  unitId        String?   // Unit ID
  unit          Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)

  propertyId    String?   // Property ID
  property      Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  workspaceId   Int?      // Workspace ID
  workspace     Workspace? @relation(fields: [workspaceId], references: [wid], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([unitId])
  @@index([propertyId])
  @@index([workspaceId])
}

model RoomHistory {
  id                String    @id @default(cuid())
  name              String    // Past Resident / Occupant Name
  period            String    // e.g. "Jan 2025 - Dec 2025"
  rent              String    // e.g. "$1,200/mo"
  status            String    @default("Lease Completed") // "Lease Completed", "Removed / Evicted", "Active Occupant"
  review            String?   // Landlord rating review / notes
  rating            Int?      @default(5) // 1-5 star rating
  healthScore       Int?      @default(85) // 85 / 100 assigned upon offboarding/leaving
  removalReason     String?   // Breach reason if evicted
  depositSettlement String?   // e.g. "Full Deposit Refunded"
  keysReturned      Boolean   @default(true)
  moveIn            DateTime?
  moveOut           DateTime?
  floorNumber       Int?

  tenantId          String?
  tenant            Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  unitId            String?
  unit              Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)

  propertyId        String?
  property          Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  workspaceId       Int?
  workspace         Workspace? @relation(fields: [workspaceId], references: [wid], onDelete: SetNull)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tenantId])
  @@index([unitId])
  @@index([propertyId])
  @@index([workspaceId])
}

model TenantDocument {
  id            String    @id @default(cuid())
  title         String    // Document title e.g. "Govt ID (Passport)", "Signed Lease Agreement"
  docType       String    @default("Lease Agreement") // "Govt ID", "Lease Agreement", "Proof of Income", etc.
  fileUrl       String    // Cloudflare R2 public URL
  fileName      String    // e.g. "passport_john.pdf"
  fileSize      String?   // e.g. "1.2 MB"
  mimeType      String?   // e.g. "application/pdf"
  floorNumber   Int?

  profileId     String?
  profile       Profile?  @relation(fields: [profileId], references: [id], onDelete: SetNull)

  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  unitId        String?
  unit          Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)

  propertyId    String?
  property      Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  workspaceId   Int?
  workspace     Workspace? @relation(fields: [workspaceId], references: [wid], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([profileId])
  @@index([tenantId])
  @@index([unitId])
  @@index([propertyId])
  @@index([workspaceId])
}

model PropertyExpense {
  id            String    @id @default(cuid())
  expenseNumber String?   // e.g. "EXP-901"
  title         String
  category      String    @default("Maintenance & Repairs")
  amount        Float     @default(0)
  date          DateTime  @default(now())
  vendor        String?
  paymentMethod String?   @default("Bank Wire / ACH Transfer")
  receiptName   String?
  receiptUrl    String?
  status        String    @default("Verified & Paid")

  unitId        String?
  unit          Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)

  propertyId    String?
  property      Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  workspaceId   Int?
  workspace     Workspace? @relation(fields: [workspaceId], references: [wid], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([unitId])
  @@index([propertyId])
  @@index([workspaceId])
}

model TeamMember {
  id          String    @id @default(cuid())
  name        String
  email       String
  countryCode String?   @default("+1")
  phone       String?
  role        String    @default("Manager") // "Owner", "Admin", "Manager", "Employee"
  status      String    @default("Active")
  password    String?

  workspaceId Int?
  workspace   Workspace? @relation(fields: [workspaceId], references: [wid], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
}

model Transaction {
  id                String    @id @default(cuid())
  transactionNumber String    // e.g. "TXN-2026-901"
  paymentId         String?   // e.g. "pay_P9283401"
  orderId           String?   // e.g. "sub_abc123" or "order_xyz"
  type              String    @default("Subscription Payment") // "Subscription Payment", "Rent Collection", "Expense Payout"
  amount            String    // e.g. "$15.00 USD" or "₹1,474"
  status            String    @default("Success")
  paymentMethod     String?   @default("Razorpay Auto-Debit")
  description       String?

  workspaceId       Int?
  workspace         Workspace? @relation(fields: [workspaceId], references: [wid], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([workspaceId])
}

model Subscription {
  id            String    @id @default(cuid())
  invoiceNumber String    // e.g. "INV-2026-008"
  receiptNumber String    // e.g. "RCPT-2026-008"
  planName      String    // e.g. "Pro Portfolio Plan"
  amount        String    // e.g. "$15.00 USD" or "₹1,474"
  billingTerm   String    @default("Monthly") // "Monthly" or "Annual"
  paymentType   String    @default("Recurring Subscription") // "Recurring Subscription" or "One-Time Payment"
  paymentMethod String    @default("Razorpay (Visa •••• 4242)")
  paymentId     String?   // Razorpay Payment ID e.g. "pay_P192834"
  status        String    @default("Paid")

  workspaceId   Int?
  workspace     Workspace? @relation(fields: [workspaceId], references: [wid], onDelete: Cascade)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId])
}

model SupportTicket {
  id            String    @id @default(cuid())
  ticketNumber  String    // e.g. "TKT-2026-001"
  subject       String
  category      String    @default("General Inquiry") // "Billing & Invoices", "Tenant Portal", "AI Documents", "Technical Issue"
  priority      String    @default("Medium") // "Low", "Medium", "High", "Urgent"
  status        String    @default("Open") // "Open", "In Progress", "Resolved", "Closed"
  message       String
  contactEmail  String?
  contactPhone  String?

  workspaceId   Int?
  workspace     Workspace? @relation(fields: [workspaceId], references: [wid], onDelete: Cascade)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId])
}

model EarlyAccessLead {
  id            String   @id @default(cuid())
  fullName      String
  email         String
  phone         String?
  portfolioType String?  // "Landlord (1-5 Units)", "Portfolio Owner (50+ Units)", etc.
  notes         String?
  createdAt     DateTime @default(now())
}
